# Frontend Environment Variables
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Razorpay (KEY_ID only - KEY_SECRET goes in Vercel environment variables, never in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Optional: For local API testing with Vercel dev
VITE_API_BASE_URL=http://localhost:3000

# Backend Environment Variables (set in Vercel dashboard)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_secret
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OWNER_EMAIL=your_email@example.com
# FROM_EMAIL=your_email@example.com
# FROM_NAME=Your Brand Name